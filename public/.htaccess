Options -MultiViews
RewriteEngine On

# Force the canonical host and HTTPS scheme.
RewriteCond %{HTTP_HOST} ^langmainternational\.com$ [NC]
RewriteRule ^ https://www.langmainternational.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTPS} off
RewriteRule ^ https://www.langmainternational.com%{REQUEST_URI} [R=301,L,NE]

# Keep common index-file variants from becoming separate accessible URLs.
RewriteRule ^(?:index|home)\.(?:html?|php)$ / [R=301,L,NE]

# Forward API requests to Laravel public folder.
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^api/(.*)$ /home/langmain/public/index.php [L]

# Directory routes use trailing slashes, matching the generated canonical URLs.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L,NE]

# Serve static files and generated route directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown URLs must be real 404s, not homepage soft-404s.
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /404.html

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|woff|woff2|eot|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000, must-revalidate"
    </FilesMatch>
</IfModule>
