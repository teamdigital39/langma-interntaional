Options -MultiViews
RewriteEngine On

# Force the canonical host and HTTPS scheme.
RewriteCond %{HTTP_HOST} ^langmainternational\.com$ [NC]
RewriteRule ^ https://www.langmainternational.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTPS} off
RewriteRule ^ https://www.langmainternational.com%{REQUEST_URI} [R=301,L,NE]

# Keep common index-file variants from becoming separate accessible URLs.
RewriteRule ^(?:index|home)\.(?:html?|php)$ / [R=301,L,NE]

# Remove the obsolete PHP front-controller segment from legacy public URLs.
RewriteRule ^public/index\.php/sitemap\.xml/?$ /sitemap.xml [R=301,L,NE]
RewriteRule ^public/index\.php(?:/(.*))?$ /public/$1 [R=301,L,NE]

# Redirect legacy main-site URLs to their current equivalent pages.
